#!/usr/bin/env bash
# アプリ固有の redact_flow.py を、egress を Anthropic (api.anthropic.com + platform.claude.com) に
# 固めた docker サンドボックス内の子 claude が、ユーザーと対話しながら実装するための launcher。
#
#   .devcontainer/core/bin/redact-flow <app> <raw.flows>
#
# やること:
#   1. extract/<app>/ を作り、redact_flow.py が無ければ identity テンプレから scaffold する。
#   2. redact 派生イメージ (.devcontainer/core/Dockerfile の redact ステージ) をビルドする。
#      redact は FROM base — dev とは独立で、依存として自動ビルドされるのは共通祖先 base だけ
#      (dev イメージはここではビルドも更新もされない)。
#   3. サンドボックスを起動する。
# サンドボックス内の egress 封じ・書込制限の実体は .devcontainer/core/redact/ の entrypoint と
# init-firewall.sh。生 flow はリポジトリに置かない (コミットで漏れる) 前提で、ここでは外部パスを
# read-only マウントするだけ。
set -euo pipefail

usage() {
    echo "usage: .devcontainer/core/bin/redact-flow <app> <raw.flows>" >&2
    exit 2
}
[ $# -eq 2 ] || usage
APP="$1"
RAW="$2"

# <app> はディレクトリ名兼 mount パスに使うので、安全な文字だけ許す。
[[ "$APP" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "app 名が不正 (英数 . _ - のみ): $APP" >&2; exit 2; }
# . / .. は弾く: APP は extract/<app> の path component なので、APP=.. だと OUT や compose の
# rw bind 元/先が extract/<app> の外 (=リポジトリ root) を指し、repo 全体が rw で露出してしまう。
case "$APP" in .|..) echo "app 名に . / .. は使えない: $APP" >&2; exit 2 ;; esac
[ -r "$RAW" ] || { echo "raw flows が読めない: $RAW" >&2; exit 2; }

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO="$(git -C "$SELF_DIR" rev-parse --show-toplevel)"
HERE="$(cd "$SELF_DIR/.." && pwd)/redact"

command -v docker >/dev/null 2>&1 || { echo "docker が無い。docker のあるホストで実行してください。" >&2; exit 1; }
docker info >/dev/null 2>&1 || { echo "docker daemon に接続できない。dockerd を起動してください。" >&2; exit 1; }

# redact の compose project 名を consumer の正式 project 名から <project>-redact で導出する
# (固定名だと複数 consumer repo で compose namespace が衝突する)。project/compose.yaml が宣言する
# name: の literal を読む (compose config を経ない理由は compose-project-name 冒頭コメント)。
# 名前は compose へ -p でも渡す: ambient な COMPOSE_PROJECT_NAME が file の name: を黙って上書きする
# ため、-p (最優先) で導出値に固定する (canon: facts/docker/compose-project-directory-and-env-resolution)。
DEVC_DIR="$(cd "$SELF_DIR/../.." && pwd)"  # consumer では .devcontainer/、kit repo ではリポジトリ root
project_name="$("$SELF_DIR/compose-project-name" "$DEVC_DIR/project/compose.yaml")"
REDACT_PROJECT="${project_name}-redact"
export REDACT_PROJECT  # compose.yaml の name: ${REDACT_PROJECT:?} 補間用 (build/run 共通)

# 事前認証共有 volume 名。inspect/create/案内で 1 箇所に集約する (literal を散らすと rename 時に
# 取りこぼす — redact_invariants_check.sh §11 が redact/compose.yaml の name: と一致を pin)。
AUTH_VOL=agent-devcontainer-redact-auth

# 子 claude の認証。egress は Anthropic に固めてあるので、平文 API キー (api.anthropic.com を透過)
# が一番素直。未設定だと子は agent-devcontainer-redact-auth volume の認証情報を使い、それも無ければ
# platform.claude.com 経由のログインを促す (= 未認証だと「お住まいの国では…」風の不親切な失敗)。
if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
    echo "[redact-flow] 注意: ANTHROPIC_API_KEY 未設定。" >&2
    echo "[redact-flow]   推奨: export ANTHROPIC_API_KEY=sk-... して再実行 (api.anthropic.com を透過)。" >&2
    echo "[redact-flow]   代替: $AUTH_VOL volume を事前に認証しておく (claude login)。" >&2
fi

OUT="$REPO/extract/$APP"
# extract/<app> が symlink だと、compose の rw bind 元 (${REDACT_REPO}/extract/${REDACT_APP}) が
# repo 外の実体を指しうる: repo 全体を ro マウントしても、その symlink 先には子が rw で書ける。
# mkdir 前に symlink を弾く (mkdir -p は symlink を辿って repo 外に実ディレクトリを作ってしまう)。
if [ -L "$OUT" ]; then
    echo "extract/$APP が symlink。実ディレクトリにしてください (repo 外への書込経路を防ぐため)。" >&2
    exit 2
fi
mkdir -p "$OUT"
# 実体パスが repo 内の extract/ 配下であることを確認する (extract や中間が symlink で repo 外を
# 指すケースも realpath で弾く)。
real_repo="$(realpath "$REPO")"
real_out="$(realpath "$OUT")"
case "$real_out" in
    "$real_repo"/extract/*) : ;;
    *) echo "extract/$APP の実体が repo の extract/ 外を指している ($real_out)。" >&2; exit 2 ;;
esac
if [ ! -e "$OUT/redact_flow.py" ]; then
    echo "[redact-flow] scaffold extract/$APP/redact_flow.py (identity テンプレ)"
    sed "s|__APP__|$APP|g" "$HERE/redact_flow.template.py" > "$OUT/redact_flow.py"
fi

# 事前認証共有 volume (redact/compose.yaml で external 宣言 — 理由はそちらのコメント)。external は
# compose が作らないため、ここで冪等に用意する (create は既存名で失敗するエンジンがあるので inspect || create)。
docker volume inspect "$AUTH_VOL" >/dev/null 2>&1 \
    || docker volume create "$AUTH_VOL" >/dev/null

# build と run で同一の呼び出し契約 (隔離・project 固定・REDACT_* 注入) を使う。配列に集約して
# 片方だけの drift を防ぐ (§12 は redact-flow の -u COMPOSE_* を 1 回しか grep しないので、二重定義だと
# 片側の隔離漏れが素通りしうる)。-p で project 名を固定し、ambient な COMPOSE_PROJECT_NAME /
# COMPOSE_ENV_FILES を env -u で無害化する (file 宣言を黙って上書き/差替えする — canon: facts/docker/compose-project-directory-and-env-resolution)。
redact_compose=(env -u COMPOSE_PROJECT_NAME -u COMPOSE_ENV_FILES
    REDACT_APP="$APP"
    REDACT_REPO="$REPO"
    REDACT_RAW="$(realpath "$RAW")"
    ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-}"
    docker compose -p "$REDACT_PROJECT" -f "$HERE/compose.yaml")

# redact 派生イメージをビルドする (compose の target は redact ステージ。共通祖先 base は BuildKit が自動)。
"${redact_compose[@]}" build

echo "[redact-flow] launch sandbox (project=$REDACT_PROJECT, egress = Anthropic only: api.anthropic.com + platform.claude.com)…"
exec "${redact_compose[@]}" run --rm redact
