#!/usr/bin/env bash
# project 層 compose ファイルが宣言する top-level `name:` を stdout へ出す。
#   usage: compose-project-name <project/compose.yaml>
# redact-flow (ホスト側) と make check-redact-config (CI/devcontainer) が同じ導出経路を共有する。
#
# `compose config` を使わず file の literal を読む理由 (どれも fail-closed 側の選択):
#   - config の project 名は ambient な COMPOSE_PROJECT_NAME に黙って上書きされる
#     (canon: facts/docker/compose-project-directory-and-env-resolution) — 導出値が環境依存になる。
#   - config は merged 形でしか valid でなく (同「最小 template 形」)、merge には project/.env の
#     全必須変数が要る — redact と無関係な変数 (PROJECT_GH_USER 等) に導出が結合してしまう。
# file 形式は kit が scaffold する `name: "<project>"` (installer が置換)。literal 宣言が契約 —
# interpolation 形 (`name: ${VAR:?}` 等) は意図して非対応 (env 依存の導出を許すと上の 2 点が再発する)。
# check-redact-config がこの parse と PyYAML parse の一致を pin する (形式 drift は check で捕まる)。
# fail-closed: name: 未宣言 (compose なら directory 名へ fallback して全 consumer が 'project' 等に
# 縮退する) と、compose の名前制約 [a-z0-9][a-z0-9_-]* 外は拒否する。
set -euo pipefail
[ $# -eq 1 ] || { echo "usage: compose-project-name <project/compose.yaml>" >&2; exit 2; }
[ -r "$1" ] || { echo "project 層 compose が無い/読めない: $1 (consumer は installer が scaffold、kit repo は make setup)" >&2; exit 1; }
# 最初の name: 行を awk で読む (first-match で exit — head へ pipe しない = SIGPIPE で診断なしに
# 死なない。sed のブロック構文 {…;q} は BSD/macOS sed が受け付けないため awk: redact-flow 経由で
# macOS ホストでも走る)。1 行目の UTF-8 BOM は除去する (Windows 系エディタが付け、YAML parser は
# 許容するため name: は valid なまま先頭一致だけが外れる)。移植性: regex 内の `\t`・`\ddd` 八進は
# POSIX ERE で非保証 (BSD awk で挙動が変わる) ため使わない — 空白は `[[:space:]]` (POSIX 保証)、
# BOM は printf で得たバイト列を変数→動的 regex にして escape 解釈を回避する。
# `name:` 直後は空白必須 (YAML の block mapping — `name:demo` は mapping でなく plain scalar)。
bom="$(printf '\357\273\277')"
line="$(LC_ALL=C awk -v bom="$bom" 'NR==1{sub("^" bom, "")} /^name:[[:space:]]/{sub(/^name:[[:space:]]+/, ""); print; exit}' "$1")"
line="${line%"${line##*[![:space:]]}"}" # 末尾空白 trim
# 受理する形を正規表現で明示する (strip の合成でなく grammar で判定 — 例えば name: "demo # x" の
# ような「引用内に # を含む値」を黙って切り詰めず fail-closed に落とすため)。値の後は
# 空白 + # コメントのみ許す (YAML のコメントは空白の後でだけ始まる)。
re_plain='^([a-z0-9][a-z0-9_-]*)([[:space:]]+#.*)?$'
re_dq='^"([a-z0-9][a-z0-9_-]*)"([[:space:]]+#.*)?$'
re_sq="^'([a-z0-9][a-z0-9_-]*)'([[:space:]]+#.*)?\$"
if [[ "$line" =~ $re_plain || "$line" =~ $re_dq || "$line" =~ $re_sq ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
else
    echo "project 名を導出できない ($1 の top-level name: が literal 宣言でない): '$line'" >&2
    exit 1
fi
